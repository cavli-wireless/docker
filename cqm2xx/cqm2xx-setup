usage() {
    cat <<EOF
cqm2xx-setup — set up and manage the CQM2xx build container.

  setup [cqm220] [cqm212] [cqm211]  install/update and (re)create the container (default: all three).
  update                  bring the container's image and bundles up to date.
  status                  show what's installed and the container's mounts.
  version                 print the target image tag and bundle version.

  --external              (default) app build only: kernel + rootfs, no Qualcomm
                          tools. Old name: --customer.
  --internal              full build (boot/tz/modem/meta): also installs the
                          Qualcomm tools (GitHub device login). Old name: --full.

  -m <dir>                bind-mount a host dir into the container (repeatable).
  --name <x>              use a separate, named container instead of the default.
  --bundle-dir <dir>      install bundles from <dir> instead of downloading them.
  --no-ssh / --ssh        don't / do mount ~/.ssh (read-only, on by default).
  -h, --help              this text.

Everything lives under \$CQM_ROOT (default ~/cqm2xx); container name:
cqm2xx_<user>. setup stages the kernel tool and the OpenWrt cache of each product
(and the Qualcomm tools with --internal).

Examples:
  ./cqm2xx-setup setup cqm220 -m /path/to/src                # first install (external)
  ./cqm2xx-setup setup cqm212 -m /path/to/src                # add cqm212 (also cqm211)
  ./cqm2xx-setup setup --internal                            # internal (qcom tools)
  ./cqm2xx-setup update                                      # bring up to date
EOF
}

state_get() { jq -r "$1 // empty" "$STATE_FILE"; }

# --- container ownership guard -----------------------------------------
# A name that exists in `docker ps -a` but isn't in our recorded list is
# refused before any `docker run`/`rm`.
container_owned() {
    jq -e --arg n "$1" '(.containers // []) | index($n) != null' "$STATE_FILE" >/dev/null
}
record_container() {
    local tmp; tmp="$(mktemp)"
    jq --arg n "$1" '.containers = ((.containers // []) + [$n] | unique)' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}
guard_container() {
    local name="$1"
    if docker ps -a --format '{{.Names}}' | grep -qx "$name" && ! container_owned "$name"; then
        die "'$name' already exists and this script did not create it — refusing to touch it. Re-run with --name <suffix> (or CQM_NAME_SUFFIX) and/or a separate CQM_ROOT to use an isolated container."
    fi
}
state_merge() {
    # $1 = space separated product list to merge in; rest of the state
    # (mounts, ssh, image/bundle version, container name) comes from globals.
    local tmp; tmp="$(mktemp)"
    local mounts_json; mounts_json="$(printf '%s\n' "${EXTRA_MOUNTS[@]:-}" | sed '/^$/d' | jq -R . | jq -s .)"
    jq --arg img "$IMAGE_TAG" --arg bv "$BUNDLE_VERSION" --arg bd "$BUNDLE_DIR" \
       --arg cname "$CONTAINER_NAME" --argjson ssh "$([[ "$SSH_ENABLED" == 1 ]] && echo true || echo false)" \
       --argjson full "$([[ "$FULL_MODE" == 1 ]] && echo true || echo false)" \
       --argjson br "$([[ "$BUILDROOT" == 1 ]] && echo true || echo false)" \
       --argjson kp "$([[ "$KPREBUILTS" == 1 ]] && echo true || echo false)" \
       --argjson mounts "$mounts_json" \
       --argjson prods "$(printf '%s\n' $1 | jq -R . | jq -s .)" \
       '.image_tag=$img | .bundle_version=$bv | .bundle_dir=$bd | .container=$cname |
        .ssh=$ssh | .full=$full | .buildroot=$br | .kprebuilts=$kp |
        .mounts=(((.mounts // []) + $mounts) | unique) |
        .products = (.products + (reduce $prods[] as $p ({}; .[$p]={"image_tag":$img,"bundle_version":$bv,"bundle_source":($bd | if . == "" then "drive" else "local:"+. end)})))' \
       "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

drive_fetch() {
    # $1 = drive file id, $2 = output path; resumes $2.part, renamed when complete
    local url="https://drive.usercontent.google.com/download?id=$1&confirm=t" rc=0
    curl -fsSL --retry 5 --retry-delay 10 -C - -o "$2.part" "$url" || rc=$?
    # 33: no range support, start over
    [[ $rc == 33 ]] && { rm -f "$2.part"; rc=0; curl -fsSL --retry 5 --retry-delay 10 -o "$2.part" "$url" || rc=$?; }
    [[ $rc == 0 ]] || die "download of $(basename "$2") failed (curl $rc) — re-run to resume"
    # Drive answers a quota/scan limit with an HTML page instead of the file
    if head -c 4096 "$2.part" | grep -qi '<html'; then
        grep -q 'Quota exceeded' "$2.part" && { rm -f "$2.part"; die "Drive download quota exceeded for $(basename "$2"), retry later"; }
        rm -f "$2.part"; die "Drive returned a web page instead of $(basename "$2"), retry later"
    fi
    mv -f "$2.part" "$2"
}

