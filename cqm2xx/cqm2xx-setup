prestage_component() {
    # $1 = component, $2 = "name sha256 id" list, $3 = dest (default $CQM_ROOT/$1/$BUNDLE_VERSION).
    # From --bundle-dir/<component> or Drive (resumed); sha256-checked, unpacked, marked .complete.
    local component="$1" files="$2" dest="${3:-$CQM_ROOT/$1/$BUNDLE_VERSION}" stage src_dir=""
    # .pins = the sha256 list staged; a changed pin restages. openwrt212 had no .pins and its pin changed.
    local pins have; pins="$(awk 'NF {print $2}' <<<"$files")"; have="$(cat "$dest/.pins" 2>/dev/null || true)"
    [[ -n "$have" || "$component" == openwrt212 ]] || have="$pins"
    [[ -f "$dest/.complete" && "$(cat "$dest/BUNDLE_VERSION" 2>/dev/null)" == "$BUNDLE_VERSION" && "$have" == "$pins" ]] \
        && { log "$component $BUNDLE_VERSION already staged at $dest"; return 0; }
    [[ -f "$dest/.complete" ]] && { log "$component: pinned content changed, restaging"; rm -f "$dest/.complete"; }
    if [[ -n "$BUNDLE_DIR" && -d "$BUNDLE_DIR/$component" ]]; then
        src_dir="$BUNDLE_DIR/$component"
        local local_bv; local_bv="$(cat "$src_dir/BUNDLE_VERSION" 2>/dev/null || true)"
        [[ "$local_bv" == "$BUNDLE_VERSION" ]] \
            || die "--bundle-dir: $src_dir/BUNDLE_VERSION is '$local_bv', expected $BUNDLE_VERSION"
    elif [[ "$files" == *"__PENDING__"* ]]; then
        die "$component bundle not published yet — pass --bundle-dir with $component/ in it"
    fi
    stage="$CQM_ROOT/cache/$component-$BUNDLE_VERSION"
    mkdir -p "$dest" "$stage"
    while read -r name sha id; do
        [[ -n "$name" ]] || continue
        local f="$stage/$name"
        if [[ -n "$src_dir" ]]; then
            f="$src_dir/$name"
            # no pinned sum yet (unpublished): the store's SHA256SUMS
            [[ "$sha" == __* ]] && sha="$(awk -v n="$name" '$2 == n || $2 ~ ("/" n "$") {print $1}' "$src_dir/SHA256SUMS" 2>/dev/null)"
            log "$component: using $f"
        elif [[ ! -f "$f" ]]; then
            log "$component: fetching $name"
            if [[ "$id" == gh:* ]]; then release_fetch "$name" "$id" "$f"; else drive_fetch "$id" "$f"; fi
        fi
        [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || die "$component/$name: no sha256 to check against"
        echo "$sha  $f" | sha256sum -c --quiet - \
            || { [[ -n "$src_dir" ]] || rm -f "$f"; die "$component/$name checksum mismatch"; }
        case "$name" in
            *.tar.zst) tar --use-compress-program="zstd -d -T0 --long=31" -xf "$f" -C "$dest";;
            *.tar)     tar -xf "$f" -C "$dest";;
            *) die "don't know how to unpack $name";;
        esac
    done <<<"$files"
    printf '%s\n' "$BUNDLE_VERSION" > "$dest/BUNDLE_VERSION"
    printf '%s\n' "$pins" > "$dest/.pins"
    touch "$dest/.complete"
    rm -rf "$stage"
    ok_size="$(du -sh "$dest" | cut -f1)"
    log "$component $BUNDLE_VERSION ready ($ok_size) at $dest"
}


# Qualcomm tool parts of a product (always the common one).
qcom_parts() {
    local p out=" qcom_common"
    for p in $1; do
        case "$p" in
            cqm220) out+=" qcom_220";;
            cqm212) out+=" qcom_212";;
            cqm211) out+=" qcom_211";;
        esac
    done
    tr ' ' '\n' <<<"$out" | awk 'NF && !s[$0]++'
}

# Runs inside a throwaway container: gh device login (if needed), then for each missing part download its release assets,
# verify, reassemble split files (name.partNNN) and unpack into $CQM_ROOT/<part>/<version>.
qcom_fetch_script() {
    cat <<'SCRIPT'
set -euo pipefail
gh auth status --hostname github.com >/dev/null 2>&1 \
    || gh auth login --hostname github.com --git-protocol https --web \
    || { echo "qcom: GitHub login failed" >&2; exit 1; }
for part in $QCOM_PARTS; do
    name="cqm22x-$part-$QCOM_VERSION.tar.zst"
    stage="$QCOM_STAGE/$part"; dest="$QCOM_ROOT/$part/$QCOM_VERSION"
    rm -rf "$stage"; mkdir -p "$stage" "$dest"
    gh release download "$QCOM_TAG" -R "$QCOM_REPO" -D "$stage" --clobber -p "$name*" \
        || { echo "qcom: could not download $name from $QCOM_REPO $QCOM_TAG — not an org member, or the asset is missing" >&2; exit 1; }
    cd "$stage"
    for p in "$name".part[0-9][0-9][0-9]; do
        [[ -e "$p" ]] || continue
        [[ -e "$name" ]] || cat "$name".part[0-9][0-9][0-9] > "$name"
        break
    done
    rm -f -- "$name".part[0-9][0-9][0-9]
    sha256sum -c "$name.sha256" || { echo "qcom: checksum mismatch for $name — nothing installed" >&2; exit 1; }
    tar --use-compress-program="zstd -d -T0 --long=31" -xf "$name" -C "$dest"
    printf '%s\n' "$QCOM_VERSION" > "$dest/BUNDLE_VERSION"
    touch "$dest/.complete"
    cd /; rm -rf "$stage"
done
SCRIPT
}

prestage_qcom_local() {
    # $1 = dest. --bundle-dir/qcom on disk (old layout: bare names, big files as name.partNNN): offline path.
    local dest="$1" src="$BUNDLE_DIR/qcom"
    [[ -d "$src" ]] || die "--bundle-dir: $src not found"
    local local_bv; local_bv="$(cat "$src/BUNDLE_VERSION" 2>/dev/null || true)"
    [[ "$local_bv" == "$BUNDLE_VERSION" ]] \
        || die "--bundle-dir: $src/BUNDLE_VERSION is '$local_bv', expected $BUNDLE_VERSION"
    [[ -f "$src/SHA256SUMS" ]] || die "--bundle-dir: $src/SHA256SUMS missing"
    ( cd "$src" && sha256sum -c SHA256SUMS >/dev/null ) \
        || die "qcom: checksum mismatch under $src"
    log "qcom: local bundle at $src"
    mkdir -p "$dest/qct/software"
    local f name base zst=(--use-compress-program="zstd -d -T0 --long=31")
    for f in "$src"/*.tar.zst "$src"/*.tar.zst.part000 "$src"/*.tar; do
        [[ -e "$f" ]] || continue
        name="$(basename "$f")"; base="${name%.part000}"
        case "$base" in
            sectools.tar.zst) cat "$src/$base"* | tar "${zst[@]}" -xf - -C "$dest";;
            *.tar.zst)        cat "$src/$base"* | tar "${zst[@]}" -xf - -C "$dest/qct/software";;
            *.tar)            tar -xf "$f" -C "$dest/qct/software";;
        esac
    done
}

# Legacy (single qcom bundle, whole release): runs inside a throwaway container: gh device login (if needed), download
# the qcom release, verify, reassemble split parts, unpack. $1 = dest.
qcom_fetch_script_legacy() {
    cat <<'SCRIPT'
set -euo pipefail
gh auth status --hostname github.com >/dev/null 2>&1 \
    || gh auth login --hostname github.com --git-protocol https --web \
    || { echo "qcom: GitHub login failed" >&2; exit 1; }
mkdir -p "$QCOM_STAGE"
gh release download "$QCOM_TAG" -R "$QCOM_REPO" -D "$QCOM_STAGE" --clobber \
    || { echo "qcom: could not download release $QCOM_TAG from $QCOM_REPO — not an org member, or the release is missing" >&2; exit 1; }
cd "$QCOM_STAGE"
sha256sum -c SHA256SUMS || { echo "qcom: checksum mismatch — nothing installed" >&2; exit 1; }
# reassemble any split parts (name.partNNN, numeric, zero-padded -> name)
for p in *.part[0-9][0-9][0-9]; do
    [[ -e "$p" ]] || continue
    base="${p%.part[0-9][0-9][0-9]}"
    [[ -e "$base" ]] && continue
    cat "${base}".part[0-9][0-9][0-9] > "$base"
done
rm -f -- *.part[0-9][0-9][0-9]
mkdir -p "$QCOM_DEST/qct/software"
for f in *.tar.zst *.tar; do
    [[ -e "$f" ]] || continue
    case "$f" in
        sectools.tar.zst|sectools.tar) tar --use-compress-program="zstd -d -T0 --long=31" -xf "$f" -C "$QCOM_DEST";;
        *.tar.zst) tar --use-compress-program="zstd -d -T0 --long=31" -xf "$f" -C "$QCOM_DEST/qct/software";;
        *.tar)     tar -xf "$f" -C "$QCOM_DEST/qct/software";;
    esac
done
cp -f BUNDLE_VERSION "$QCOM_DEST/BUNDLE_VERSION"
touch "$QCOM_DEST/.complete"
SCRIPT
}

# Old single-bundle layout (state qcom/<version>, qct/software + sectools): kept for old --bundle-dir/qcom dirs
# and for CQM_QCOM_LEGACY=1 (whole release of tag qcom-<version>).
prestage_qcom_legacy() {
    local dest="$CQM_ROOT/qcom/$BUNDLE_VERSION"
    [[ -f "$dest/.complete" ]] && { log "qcom $BUNDLE_VERSION already staged at $dest"; return 0; }
    mkdir -p "$CQM_ROOT/cache" "$dest"
    if [[ -n "$BUNDLE_DIR" && -d "$BUNDLE_DIR/qcom" ]]; then
        prestage_qcom_local "$dest"
        printf '%s\n' "$BUNDLE_VERSION" > "$dest/BUNDLE_VERSION"
        touch "$dest/.complete"
        log "qcom $BUNDLE_VERSION ready ($(du -sh "$dest" | cut -f1)) at $dest"
        return 0
    fi
    local tag="qcom-$BUNDLE_VERSION"
    log "qcom (legacy bundle): GitHub login (device code) + download from $QCOM_RELEASE_REPO tag $tag"
    mkdir -p "$CQM_ROOT/home"
    local tty_flag=-i; [[ -t 0 ]] && tty_flag=-it
    local qlog; qlog="$(mktemp)"
    set +e
    docker run --rm "$tty_flag" \
        -e "CQM_UID=$(id -u)" -e "CQM_GID=$(id -g)" -e "CQM_USER=$(id -un)" -e "CQM_GROUP=$(id -gn)" -e "CQM_HOME=$HOME" \
        -e "QCOM_REPO=$QCOM_RELEASE_REPO" -e "QCOM_TAG=$tag" \
        -e "QCOM_STAGE=$CQM_ROOT/cache/qcom-release-$tag" -e "QCOM_DEST=$dest" \
        -v "$CQM_ROOT/home:$HOME" -v "$CQM_ROOT/qcom:$CQM_ROOT/qcom" -v "$CQM_ROOT/cache:$CQM_ROOT/cache" \
        "$DOCKER_IMG:$IMAGE_TAG" bash -c "$(qcom_fetch_script_legacy)" 2>&1 | tee "$qlog"
    local rc=${PIPESTATUS[0]}
    set -e
    [[ $rc -eq 0 ]] || die "qcom bundle: nothing installed — $(tail -n 3 "$qlog" | tr '\n' ' ')"
    rm -f "$qlog"
    [[ -f "$dest/.complete" ]] || die "qcom bundle: did not complete — nothing installed"
    rm -rf "$CQM_ROOT/cache/qcom-release-$tag"
    log "qcom $BUNDLE_VERSION ready ($(du -sh "$dest" | cut -f1)) at $dest"
}

# Stage the Qualcomm tool parts $1 = product list needs: --bundle-dir/<part>/, else the private GitHub release.
prestage_qcom() {
    local part missing=""
    # old layout: an old --bundle-dir/qcom dir (no split parts beside it), an already staged qcom/<version>, or CQM_QCOM_LEGACY=1
    if [[ "${CQM_QCOM_LEGACY:-0}" == 1 || -f "$CQM_ROOT/qcom/$BUNDLE_VERSION/.complete" \
          || ( -n "$BUNDLE_DIR" && -d "$BUNDLE_DIR/qcom" && ! -d "$BUNDLE_DIR/qcom_common" ) ]]; then
        prestage_qcom_legacy; return 0
    fi
    for part in $(qcom_parts "$1"); do
        if [[ -n "$BUNDLE_DIR" && -d "$BUNDLE_DIR/$part" ]]; then
            prestage_component "$part" "$(bundle_files "$part")"
        elif [[ -f "$CQM_ROOT/$part/$BUNDLE_VERSION/.complete" ]]; then
            log "$part $BUNDLE_VERSION already staged at $CQM_ROOT/$part/$BUNDLE_VERSION"
        else
            missing+=" $part"
        fi
    done
    [[ -n "$missing" ]] || return 0
    log "qcom:$missing — GitHub login (device code) + download from $QCOM_RELEASE_REPO tag $QCOM_RELEASE_TAG"
    mkdir -p "$CQM_ROOT/home" "$CQM_ROOT/cache"
    # -t only with a real terminal on stdin — a plain -i still shows the device code over SSH or a background run.
    local tty_flag=-i; [[ -t 0 ]] && tty_flag=-it
    local qlog rc; qlog="$(mktemp)"
    set +e
    docker run --rm "$tty_flag" \
        -e "CQM_UID=$(id -u)" -e "CQM_GID=$(id -g)" -e "CQM_USER=$(id -un)" -e "CQM_GROUP=$(id -gn)" -e "CQM_HOME=$HOME" \
        -e "QCOM_REPO=$QCOM_RELEASE_REPO" -e "QCOM_TAG=$QCOM_RELEASE_TAG" -e "QCOM_VERSION=$BUNDLE_VERSION" \
        -e "QCOM_PARTS=${missing# }" -e "QCOM_ROOT=$CQM_ROOT" -e "QCOM_STAGE=$CQM_ROOT/cache/qcom-release-$QCOM_RELEASE_TAG" \
        -v "$CQM_ROOT/home:$HOME" -v "$CQM_ROOT:$CQM_ROOT" \
        "$DOCKER_IMG:$IMAGE_TAG" bash -c "$(qcom_fetch_script)" 2>&1 | tee "$qlog"
    rc=${PIPESTATUS[0]}
    set -e
    [[ $rc -eq 0 ]] || die "qcom: nothing installed — $(tail -n 3 "$qlog" | tr '\n' ' ')"
    rm -f "$qlog"
    for part in $missing; do
        [[ -f "$CQM_ROOT/$part/$BUNDLE_VERSION/.complete" ]] || die "qcom: $part did not complete"
        log "$part $BUNDLE_VERSION ready ($(du -sh "$CQM_ROOT/$part/$BUNDLE_VERSION" | cut -f1))"
    done
}

# Mount specs for the Qualcomm tools of $1 = product list: one mount per staged tool version (llvm 16.0.2.0 is also
# mounted as 16.0.2, where a build asks for it), so the parts add up. An old single qcom/<version> bundle still mounts whole.
qcom_mounts() {
    local qold="$CQM_ROOT/qcom/$BUNDLE_VERSION" part root d rel
    if [[ -f "$qold/.complete" ]]; then
        echo "$qold/qct/software/HEXAGON_Tools:/pkg/qct/software/HEXAGON_Tools:ro"
        echo "$qold/qct/software/arm:/pkg/qct/software/arm:ro"
        echo "$qold/qct/software/llvm:/pkg/qct/software/llvm:ro"
        echo "$qold/sectools:/pkg/sectools:ro"
        return
    fi
    for part in $(qcom_parts "$1"); do
        root="$CQM_ROOT/$part/$BUNDLE_VERSION"
        [[ -f "$root/.complete" ]] || continue
        [[ -d "$root/sectools" ]] && echo "$root/sectools:/pkg/sectools:ro"
        for d in "$root"/qct/software/llvm/release/arm/*/ "$root"/qct/software/HEXAGON_Tools/*/ "$root"/qct/software/arm/*/; do
            [[ -d "$d" ]] || continue
            d="${d%/}"; rel="${d#"$root"/}"
            echo "$d:/pkg/$rel:ro"
            [[ "$rel" == qct/software/llvm/release/arm/*.*.*.* ]] && echo "$d:/pkg/${rel%.*}:ro"
        done
    done
    return 0
}

prestage_buildroot() { prestage_optional buildroot "$CQM_ROOT/buildroot"; }

prestage_optional() {
    # $1 = component, $2 = dest (optional). Unpublished and not in --bundle-dir: skipped.
    local files; files="$(pick_files "$1")"
    if [[ "$files" == *"__PENDING__"* && ! -d "${BUNDLE_DIR:-/nonexistent}/$1" ]]; then
        log "$1 bundle not published yet — skipped (the first build fetches or builds it)"; return 0
    fi
    [[ "$files" == *"__PENDING__"* ]] && log "$1 bundle not published yet — taking it from $BUNDLE_DIR/$1"
    prestage_component "$1" "$files" ${2:+"$2"}
}

prestage_prebuilts() {
    # cqm211 needs qcom + yocto, but `prebuilts` lives in the openwrt bundle.
    local qcom_dest="$CQM_ROOT/qcom/$BUNDLE_VERSION"
    [[ -d "$qcom_dest/prebuilts" ]] && { log "prebuilts already in the qcom bundle (old layout) — nothing to stage"; return 0; }
    local dest="$CQM_ROOT/openwrt/$BUNDLE_VERSION"
    [[ -d "$dest/prebuilts" ]] && { log "prebuilts already staged at $dest/prebuilts"; return 0; }

    local line name sha id
    line="$(grep '^prebuilts\.tar\.zst ' <<<"$BUNDLE_FILES_openwrt_drive")"
    [[ -n "$line" ]] || die "prebuilts.tar.zst not in the openwrt bundle file list"
    read -r name sha id <<<"$line"

    mkdir -p "$dest" "$CQM_ROOT/cache"
    local stage="$CQM_ROOT/cache/openwrt-$BUNDLE_VERSION"
    mkdir -p "$stage"
    local f="$stage/$name"
    if [[ ! -f "$f" ]] || ! echo "$sha  $f" | sha256sum -c --quiet - 2>/dev/null; then
        if [[ -n "$BUNDLE_DIR" ]]; then
            local src_dir="$BUNDLE_DIR/openwrt"
            [[ -d "$src_dir" ]] || die "--bundle-dir: $src_dir not found"
            local local_bv; local_bv="$(cat "$src_dir/BUNDLE_VERSION" 2>/dev/null || true)"
            [[ "$local_bv" == "$BUNDLE_VERSION" ]] \
                || die "--bundle-dir: $src_dir/BUNDLE_VERSION is '$local_bv', expected $BUNDLE_VERSION"
            log "prebuilts: taking $name from $src_dir"
            cp "$src_dir/$name" "$f"
        else
            log "prebuilts: fetching $name"
            drive_fetch "$id" "$f"
        fi
        echo "$sha  $f" | sha256sum -c - || die "openwrt/$name checksum mismatch"
    fi
    tar --use-compress-program="zstd -d -T0 --long=31" -xf "$f" -C "$dest"
    rm -f "$f"
    log "prebuilts ready at $dest/prebuilts"
}

# shared kernel-build prebuilts (clang/gcc/ndk/jdk/bazel): qcom/<v>/prebuilts
# (old bundles) or openwrt/<v>/prebuilts (new, shared by every qcom user).
resolve_prebuilts_dir() {
    local qdir="$1" odir="$CQM_ROOT/openwrt/$BUNDLE_VERSION"
    [[ -d "$qdir/prebuilts" ]] && { echo "$qdir/prebuilts"; return; }
    [[ -d "$odir/prebuilts" ]] && { echo "$odir/prebuilts"; return; }
    echo ""
}

# --- one container, every installed product --------------------------------
# Builds the `docker run` args for $1 = full product list into RUN_ARGS.
# Writable ccache/OpenWrt caches are namespaced per product (/ccache/<p>,
# /pkg/openwrt/<p>); point CCACHE_DIR at your product's subpath when building.
build_run_args() {
    local products="$1"
    RUN_ARGS=(--name "$CONTAINER_NAME" --hostname "$CONTAINER_BASE" -dit
              -e "TERM=xterm-256color"
              -e "CQM_UID=$(id -u)" -e "CQM_GID=$(id -g)"
              -e "CQM_USER=$(id -un)" -e "CQM_GROUP=$(id -gn)"
              -e "CQM_HOME=$HOME"
              -e "CQM_PRODUCTS=$(tr ' ' ',' <<<"$products")"
              --add-host "${CONTAINER_BASE}:127.0.0.1"
              -v /etc/localtime:/etc/localtime:ro)

    local groups; groups="$(id -G | tr ' ' '\n' | grep -vx "$(id -g)" | paste -sd, -)"
    [[ -n "$groups" ]] && RUN_ARGS+=(-e "CQM_GROUPS=$groups")

    # home: $CQM_ROOT/home, never the real one, at the host's own $HOME path.
    mkdir -p "$CQM_ROOT/home"
    RUN_ARGS+=(-v "$CQM_ROOT/home:$HOME")
    if [[ "$SSH_ENABLED" == 1 && -d "$HOME/.ssh" ]]; then
        RUN_ARGS+=(-v "$HOME/.ssh:$HOME/.ssh:ro")
    fi

    # workspace + any extra -m dirs, each at the same path host and container.
    mkdir -p "$CQM_ROOT/workspace"
    RUN_ARGS+=(-v "$CQM_ROOT/workspace:$CQM_ROOT/workspace")
    local m
    for m in "${ALL_MOUNTS[@]}"; do
        [[ "$m" == "$CQM_ROOT/workspace" ]] && continue
        RUN_ARGS+=(-v "$m:$m")
    done

    RUN_ARGS+=(-e "CQM_FULL=$FULL_MODE")

    local need_qcom=no need_openwrt=no need_openwrt212=no need_yocto=no p
    for p in $products; do
        case "$p" in cqm220|cqm212|cqm211) need_qcom=yes;; esac
        case "$p" in cqm220) need_openwrt=yes;; esac
        case "$p" in cqm212) need_openwrt212=yes;; esac
        case "$p" in cqm211) need_yocto=yes;; esac
    done

    # customer (default) install: no qcom bundle, no qcom mounts, regardless
    # of which products are otherwise installed.
    [[ "$FULL_MODE" == 1 ]] || need_qcom=no

    if [[ "$need_qcom" == yes ]]; then
        local spec
        while read -r spec; do [[ -n "$spec" ]] && RUN_ARGS+=(-v "$spec"); done < <(qcom_mounts "$products")
    fi
    # shared kernel-build prebuilts (public; LE.1.0 lines and cqm211 link /pkg/prebuilts), both paths
    local prebuilts_dir; prebuilts_dir="$(resolve_prebuilts_dir "$CQM_ROOT/qcom/$BUNDLE_VERSION")"
    [[ -n "$prebuilts_dir" ]] && RUN_ARGS+=(-v "$prebuilts_dir:/pkg/prebuilts:ro")
    if [[ "$need_openwrt" == yes ]]; then
        local openwrt_dir="$CQM_ROOT/openwrt/$BUNDLE_VERSION"
        RUN_ARGS+=(-v "$openwrt_dir/openwrt-prebuilt-backup:/pkg/openwrt-prebuilt-backup:ro")
        [[ -f "$openwrt_dir/BUNDLE_VERSION" ]] && RUN_ARGS+=(-v "$openwrt_dir/BUNDLE_VERSION:/pkg/OPENWRT_VERSION:ro")
    fi
    if [[ "$need_openwrt212" == yes ]]; then
        local oc="$CQM_ROOT/openwrt212/$BUNDLE_VERSION/openwrt-prebuilt-backup"
        [[ -d "$oc" ]] && RUN_ARGS+=(-v "$oc:/pkg/cqm212-openwrt-prebuilt:ro"
                                     -e "OPENWRT_PREBUILT_CACHE_DIR=/pkg/cqm212-openwrt-prebuilt")
        local kp="$CQM_ROOT/kprebuilts212/$BUNDLE_VERSION/prebuilts-kobuk"
        [[ "$KPREBUILTS" == 1 && -d "$kp" ]] && RUN_ARGS+=(-v "$kp:/pkg/prebuilts-kobuk:ro")
    fi
    if [[ "$need_yocto" == yes ]]; then
        local yocto_dir="$CQM_ROOT/yocto/$BUNDLE_VERSION"
        # DL_DIR = the staged downloads, writable (Yocto adds files, .done stamps and locks)
        RUN_ARGS+=(-v "$yocto_dir/downloads:/pkg/yocto/downloads")
        [[ -d "$yocto_dir/llvm-arm-toolchain-ship" ]] && RUN_ARGS+=(-v "$yocto_dir/llvm-arm-toolchain-ship:/pkg/yocto/llvm-arm-toolchain-ship:ro")
    fi

    # line bundles, one read-only mount per AU tag (an AU symlink mounts its target)
    local c d
    for c in $(for p in $products; do line_bundles "$p"; done | sort -u); do
        for d in "$CQM_ROOT/$c/$BUNDLE_VERSION"/{openwrt_cache,yocto}/*/; do
            [[ -d "$d" ]] || continue
            d="${d%/}"; RUN_ARGS+=(-v "$(realpath "$d"):/pkg/${d#"$CQM_ROOT/$c/$BUNDLE_VERSION/"}:ro")
        done
    done

    # Buildroot dl/ccache writable, the default path of its scripts; toolchain read-only.
    mkdir -p "$CQM_ROOT/buildroot/dl" "$CQM_ROOT/buildroot/ccache"
    RUN_ARGS+=(-v "$CQM_ROOT/buildroot:/pkg/buildroot")
    [[ -d "$CQM_ROOT/buildroot/toolchain" ]] \
        && RUN_ARGS+=(-v "$CQM_ROOT/buildroot/toolchain:/pkg/buildroot/toolchain:ro")

    # per-product writable caches — never shared between products.
    for p in $products; do
        case "$p" in
            cqm220|cqm212)
                mkdir -p "$CQM_ROOT/cache/$p/ccache"
                RUN_ARGS+=(-v "$CQM_ROOT/cache/$p/ccache:/ccache/$p")
                ;;
        esac
        case "$p" in
            cqm220)
                mkdir -p "$CQM_ROOT/cache/$p/openwrt"
                RUN_ARGS+=(-v "$CQM_ROOT/cache/$p/openwrt:/pkg/openwrt/$p")
                ;;
        esac
    done
}

cmd_setup() {
    local new_products="${*:-$ALL_PRODUCTS}" c
    new_products="$(tr ', ' '  ' <<<"$new_products")"
    for p in $new_products; do
        case " $ALL_PRODUCTS " in *" $p "*) ;; *) die "unknown product: $p";; esac
    done

    guard_container "$CONTAINER_NAME"

    # external (default): never fetch/stage/decrypt qcom. internal (or a
    # previous internal setup recorded in state.json): stage it.
    [[ "$FULL_MODE" == 1 ]] && prestage_qcom "$new_products"
    for p in $new_products; do
        case "$p" in
            cqm220) prestage_component openwrt "$(openwrt_files)"
                               [[ "$BUILDROOT" == 1 ]] && prestage_buildroot
                               for c in $(line_bundles "$p"); do prestage_optional "$c"; done;;
            cqm211)            prestage_component yocto "$(pick_files yocto)"
                               for c in $(line_bundles "$p"); do prestage_optional "$c"; done;;
            cqm212)            prestage_optional openwrt212
                               [[ "$KPREBUILTS" == 1 ]] && prestage_optional kprebuilts212
                               for c in $(line_bundles "$p"); do prestage_optional "$c"; done;;
        esac
    done

    local installed; installed="$(state_get '.products | keys | join(" ")')"
    local all_products; all_products="$(printf '%s\n' $installed $new_products | sort -u | tr '\n' ' ')"

    log "pulling $DOCKER_IMG:$IMAGE_TAG"
    docker pull "$DOCKER_IMG:$IMAGE_TAG" >/dev/null

    build_run_args "$all_products"
    if container_owned "$CONTAINER_NAME"; then
        docker ps --format '{{.Names}}' | grep -qx "$CONTAINER_NAME" \
            && log "recreating $CONTAINER_NAME — anything running inside it is stopped"
        docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
    fi
    docker run "${RUN_ARGS[@]}" "$DOCKER_IMG:$IMAGE_TAG" tail -f /dev/null >/dev/null
    record_container "$CONTAINER_NAME"

    # wait for entrypoint.sh's useradd before printing the exec hint below.
    local i; for i in $(seq 1 30); do
        docker exec "$CONTAINER_NAME" id "$(id -un)" >/dev/null 2>&1 && break
        sleep 0.5
    done

    # Buildroot host deps missing from images <= 1.1.4.
    docker exec -u 0 "$CONTAINER_NAME" sh -c 'command -v bc >/dev/null && command -v cpio >/dev/null ||
        { apt-get update -qq && apt-get install -y -qq --no-install-recommends bc cpio >/dev/null 2>&1; }' \
        || log "warning: could not install bc/cpio (needed by Buildroot)"

    state_merge "$new_products"
    [[ "$SSH_ENABLED" == 1 ]] && { [[ -d "$HOME/.ssh" ]] && log "mounted ~/.ssh read-only" || log "~/.ssh not found — skipped"; } \
        || log "~/.ssh not mounted (--no-ssh)"
    log "done. container: $CONTAINER_NAME. installed products: $(state_get '.products | keys | join(",")')"
    log "shell in: docker exec -it --user \$(id -un) -e HOME=\$HOME $CONTAINER_NAME bash -l"
}

cmd_update() {
    local installed; installed="$(state_get '.products | keys | join(" ")')"
    [[ -n "$installed" ]] || die "nothing installed yet — run 'setup' first"
    local cur_img cur_bv
    cur_img="$(state_get '.image_tag')"; cur_bv="$(state_get '.bundle_version')"
    log "updating: image $cur_img -> $IMAGE_TAG, bundles $cur_bv -> $BUNDLE_VERSION"
    log "recorded products: $installed"
    # Always re-pull + recreate: an image can be republished under the same
    # tag, so a tag match alone doesn't mean nothing changed.
    cmd_setup "$(tr ' ' ',' <<<"$installed")"
}

cmd_status() {
    echo "container: $CONTAINER_NAME"
    echo "path: $([[ "$FULL_MODE" == 1 ]] && echo 'internal (full build)' || echo 'external (app build only)')"
    echo "image tag (target):   $IMAGE_TAG"
    echo "bundle version (target): $BUNDLE_VERSION"
    echo "bundle source: $(state_get '.bundle_dir' | sed 's/^$/drive/')"
    echo "ssh mounted: $(state_get '.ssh')"
    echo "buildroot bundle: $(cat "$CQM_ROOT/buildroot/BUNDLE_VERSION" 2>/dev/null || echo none)$([[ "$BUILDROOT" == 1 ]] || echo ' (off)')"
    echo "installed:"
    jq -r '.products | to_entries[] | "  \(.key): image=\(.value.image_tag) bundle=\(.value.bundle_version) source=\(.value.bundle_source // "drive")"' "$STATE_FILE"
    echo "mounts:"
    echo "  $CQM_ROOT/workspace (default)"
    jq -r '.mounts[]? | "  \(.)"' "$STATE_FILE"
    echo "staged prebuilts:"
    local p c d want=""
    for p in $(state_get '.products | keys | join(" ")'); do
        case "$p" in
            cqm220) want+=" openwrt";;
            cqm211) want+=" yocto";;
            cqm212) want+=" openwrt212"; [[ "$KPREBUILTS" == 1 ]] && want+=" kprebuilts212";;
        esac
        want+=" $(line_bundles "$p" | tr '\n' ' ')"
    done
    [[ "$FULL_MODE" == 1 ]] && want="$(qcom_parts "$(state_get '.products | keys | join(" ")')" | tr '\n' ' ') $want"
    for c in $(tr ' ' '\n' <<<"$want" | awk 'NF && !seen[$0]++'); do
        d="$CQM_ROOT/$c/$BUNDLE_VERSION"
        if [[ -f "$d/.complete" ]]; then
            printf '  %-18s ok       %6s  %s\n' "$c" "$(du -sh "$d" 2>/dev/null | cut -f1)" \
                "$(cd "$d" && ls -d openwrt_cache/* yocto/* 2>/dev/null | sed 's#^#/pkg/#' | tr '\n' ' ')"
        elif [[ "$(bundle_files "$c")" == *__PENDING__* ]]; then
            printf '  %-18s pending  (not published; the first build fetches or builds it)\n' "$c"
        else
            printf '  %-18s missing  (run setup)\n' "$c"
        fi
    done
    echo "lines:"
    local installed line prod comps miss
    installed=" $(state_get '.products | keys | join(" ")') "
    while read -r line prod comps; do
        [[ -n "$line" && "$installed" == *" $prod "* ]] || continue
        miss=""
        [[ "$FULL_MODE" == 1 ]] && comps="$(qcom_parts "$prod" | tr '\n' ' ') $comps"
        for c in $comps; do
            case "$c" in
                prebuilts) [[ -n "$(resolve_prebuilts_dir "$CQM_ROOT/qcom/$BUNDLE_VERSION")" ]] && continue;;
                kprebuilts*) [[ "$KPREBUILTS" == 1 ]] || { miss+=" $c (--no-kernel-prebuilts)"; continue; }
                             [[ -f "$CQM_ROOT/$c/$BUNDLE_VERSION/.complete" ]] && continue;;
                *) [[ -f "$CQM_ROOT/$c/$BUNDLE_VERSION/.complete" ]] && continue;;
            esac
            [[ "$(bundle_files "$c")" == *__PENDING__* ]] && miss+=" $c (not published)" || miss+=" $c (run setup)"
        done
        if [[ -z "$miss" ]]; then printf '  \u2713 %-7s %-9s all prebuilts staged\n' "$line" "$prod"
        else printf '  \u2717 %-7s %-9s missing:%s\n' "$line" "$prod" "$miss"; fi
    done <<<"$LINES"
    if docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
        echo "/pkg in $CONTAINER_NAME:"
        docker inspect "$CONTAINER_NAME" --format '{{range .Mounts}}{{.Destination}}{{if not .RW}} (ro){{end}}{{"\n"}}{{end}}' \
            | grep '^/pkg' | sort | sed 's/^/  /'
    fi
}

cmd_version() { echo "cqm2xx-setup: image=$IMAGE_TAG bundle=$BUNDLE_VERSION"; }

# --- option parsing (options may appear anywhere on the command line) -----
ALL_MOUNTS=()
SSH_ENABLED=1
BUILDROOT=""
KPREBUILTS=""
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --name)       CQM_NAME_SUFFIX="$2"; shift 2;;
        --bundle-dir) BUNDLE_DIR="$2"; shift 2;;
        -m)           mount_rp="$(realpath -e -- "$2" 2>/dev/null)" || die "-m $2: no such directory"
                      ALL_MOUNTS+=("$mount_rp"); shift 2;;
        --no-ssh)     SSH_ENABLED=0; shift;;
        --ssh)        SSH_ENABLED=1; shift;;
        --internal|--full)     FULL_MODE=1; shift;;
        --external|--customer) FULL_MODE=0; shift;;
        --no-buildroot) BUILDROOT=0; shift;;
        --buildroot)    BUILDROOT=1; shift;;
        --no-kernel-prebuilts) KPREBUILTS=0; shift;;
        --kernel-prebuilts)    KPREBUILTS=1; shift;;
        *)            ARGS+=("$1"); shift;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
CONTAINER_NAME="${CONTAINER_BASE}_$(id -un)${CQM_NAME_SUFFIX:+_$CQM_NAME_SUFFIX}"
CMD="${1:-}"

# -h/--help/version need no state file at all.
case "$CMD" in
    -h|--help|"") usage; exit 0;;
    version)      cmd_version; exit 0;;
esac

mkdir -p "$STATE_DIR"
[[ -f "$STATE_FILE" ]] || echo '{"products":{},"image_tag":"","bundle_version":"","containers":[],"mounts":[],"ssh":true,"full":false}' > "$STATE_FILE"
[[ -n "$BUNDLE_DIR" ]] || BUNDLE_DIR="$(state_get '.bundle_dir')"

# fold in mounts/ssh flag remembered from a previous run.
EXTRA_MOUNTS=("${ALL_MOUNTS[@]}")
while IFS= read -r m; do [[ -n "$m" ]] && ALL_MOUNTS+=("$m"); done < <(jq -r '.mounts[]?' "$STATE_FILE")
mapfile -t ALL_MOUNTS < <(printf '%s\n' "${ALL_MOUNTS[@]}" | sort -u | sed '/^$/d')
if [[ "$SSH_ENABLED" == 1 ]]; then
    saved_ssh="$(jq -r '.ssh' "$STATE_FILE")"
    [[ "$saved_ssh" == "false" ]] && SSH_ENABLED=0
fi

# buildroot bundle: off unless --buildroot now or in a previous setup.
[[ -n "$BUILDROOT" ]] || { [[ "$(jq -r '.buildroot' "$STATE_FILE")" == "true" ]] && BUILDROOT=1 || BUILDROOT=0; }
# kernel prebuilts: on unless --no-kernel-prebuilts now or in a previous setup.
[[ -n "$KPREBUILTS" ]] || { [[ "$(jq -r '.kprebuilts' "$STATE_FILE")" == "false" ]] && KPREBUILTS=0 || KPREBUILTS=1; }

# --internal/--external win; otherwise reuse a previous setup's recorded path.
[[ -n "$FULL_MODE" ]] || { [[ "$(state_get '.full')" == "true" ]] && FULL_MODE=1 || FULL_MODE=0; }

case "$CMD" in
    setup)   shift; cmd_setup "$@";;
    update)  shift; cmd_update "$@";;
    status)  cmd_status;;
    *) die "unknown command: $CMD (setup|update|status|version)";;
esac
