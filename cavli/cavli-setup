# GitHub release assets of the public bundles repo; spec = gh:<tag>[:<n parts>] (parts name.part00..), joined in order.
BUNDLES_REPO="${CAVLI_BUNDLES_REPO:-cavli-wireless-public/cqm2xx-bundles}"
release_fetch() {
    # $1 = asset name, $2 = gh:<tag>[:<n>], $3 = output path; each part resumes, then parts are joined
    local tag="${2#gh:}" n=1 i part rc out="$3"
    [[ "$tag" == *:* ]] && { n="${tag#*:}"; tag="${tag%%:*}"; }
    local base="https://github.com/$BUNDLES_REPO/releases/download/$tag"
    if (( n == 1 )); then
        curl -fL --retry 5 --retry-delay 10 -C - -o "$out.part" "$base/$1" || die "download of $1 failed — re-run to resume"
        mv -f "$out.part" "$out"; return 0
    fi
    : > "$out.join"
    for ((i = 0; i < n; i++)); do
        part="$out.p$(printf '%02d' "$i")"
        [[ -f "$part" ]] || { curl -fL --retry 5 --retry-delay 10 -C - -o "$part.part" "$base/$1.part$(printf '%02d' "$i")" \
            || die "download of $1.part$(printf '%02d' "$i") failed — re-run to resume"; mv -f "$part.part" "$part"; }
        cat "$part" >> "$out.join"
    done
    mv -f "$out.join" "$out"; rm -f "$out".p[0-9][0-9]
}

# --- fast download ----------------------------------------------------------
# One GitHub connection gives ~35 MB/s; 4+ together fill a 1 Gb/s link. So every GitHub asset is cut into ranges of
# CAVLI_DL_CHUNK_MB, fetched by a shared pool of CAVLI_DL_JOBS connections (all items together) and read back in order
# as ONE stream: sha256 | zstd -d | tar, extracting while the rest still downloads (no join copy, no second sha pass).
# Chunks stay in cache/ until the item is verified, so a re-run resumes. CAVLI_DL_JOBS=0: old one-file-at-a-time path.
DL_JOBS="${CAVLI_DL_JOBS:-8}"; DL_CHUNK_MB="${CAVLI_DL_CHUNK_MB:-256}"
[[ "$DL_JOBS" =~ ^[0-9]+$ && "$DL_CHUNK_MB" =~ ^[1-9][0-9]*$ ]] || { echo "[cavli-setup] error: CAVLI_DL_JOBS / CAVLI_DL_CHUNK_MB must be numbers" >&2; exit 1; }
DL_CHUNK=$((DL_CHUNK_MB * 1048576))

fmt_secs() { printf '%dm%02ds' $(($1 / 60)) $(($1 % 60)); }

# Connection pool: DL_JOBS tokens in a pipe on fd 9, inherited by every background job.
pool_init() {
    local f i; f="$(mktemp -u "${TMPDIR:-/tmp}/cavli-pool.XXXXXX")"
    mkfifo "$f"; exec 9<>"$f"; rm -f "$f"
    for ((i = 0; i < DL_JOBS; i++)); do printf x >&9; done
}

# Content-Length of a URL ($2 = optional curl header file); fails when unknown.
url_size() {
    local s
    s="$(curl -fsSIL --retry 3 ${2:+-H "@$2"} "$1" | tr -d '\r' | awk 'tolower($1) == "content-length:" {v = $2} END {print v + 0}')" || return 1
    (( s > 0 )) && echo "$s"
}

# One byte range FIRST..LAST of URL into OUT; resumes OUT.part, renamed when complete ($5 = optional curl header file).
chunk_get() {
    local url="$1" a="$2" b="$3" out="$4" hdr="${5:-}" want have try
    want=$((b - a + 1))
    [[ "$(stat -c%s "$out" 2>/dev/null || echo -1)" == "$want" ]] && return 0
    rm -f "$out"
    for try in 1 2 3 4 5 6; do
        have=$(stat -c%s "$out.part" 2>/dev/null || echo 0)
        (( have < want )) || break
        curl -fsSL ${hdr:+-H "@$hdr"} -r "$((a + have))-$b" "$url" >> "$out.part" 2>/dev/null || sleep $((try * 2))
    done
    [[ "$(stat -c%s "$out.part" 2>/dev/null || echo 0)" == "$want" ]] || { rm -f "$out.part"; return 1; }
    mv -f "$out.part" "$out"
}

# stream_extract LABEL SHA DEST STAGE [HDRFILE] < lines "url size" (in stream order)
# Fetches the ranges, extracts into DEST while downloading and checks the sha256 of the whole stream.
# Returns 1: download or unpack failed (STAGE kept, re-run resumes); 2: checksum mismatch (all removed).
stream_extract() {
    local label="$1" sha="$2" dst="$3" stage="$4" hdr="${5:-}" url size i=0 j n a b total=0 chunks=() c f dpid rpid spid rc=0 got
    while read -r url size; do
        [[ -n "$url" ]] || continue
        n=$(( (size + DL_CHUNK - 1) / DL_CHUNK ))
        for ((j = 0; j < n; j++)); do
            a=$((j * DL_CHUNK)); b=$((a + DL_CHUNK - 1)); (( b < size )) || b=$((size - 1))
            chunks+=("$url $a $b $stage/$(printf 'c%02d_%04d' "$i" "$j")")
        done
        total=$((total + size)); i=$((i + 1))
    done
    mkdir -p "$stage" "$dst"; rm -f "$stage"/.fail "$stage"/.stop "$stage"/sha.out; rm -rf "$dst"; mkdir -p "$dst"
    # dispatcher: chunks in stream order, each waits for a pool token
    (
        for c in "${chunks[@]}"; do
            [[ -e "$stage/.stop" ]] && break
            read -r -n1 -u 9 _ || break
            ( # shellcheck disable=SC2086
              set -- $c; chunk_get "$1" "$2" "$3" "$4" "$hdr" || : > "$stage/.fail"; printf x >&9 ) &
        done
        wait
    ) &
    dpid=$!
    # progress every 10 s: bytes on disk, rate over the last interval, elapsed
    (
        local_t0=$SECONDS; prev=0; pt=$SECONDS
        while sleep 10; do
            got=$(stat -c%s "$stage"/c* 2>/dev/null | awk '{s += $1} END {print s + 0}')
            log "$label: $((got >> 20)) / $((total >> 20)) MB ($((100 * got / total))%)  $(( (got - prev) / (SECONDS - pt) >> 20 )) MB/s  $(fmt_secs $((SECONDS - local_t0)))"
            prev=$got; pt=$SECONDS
        done
    ) &
    rpid=$!
    rm -f "$stage/sha.fifo"; mkfifo "$stage/sha.fifo"
    ( sha256sum < "$stage/sha.fifo" | cut -d' ' -f1 > "$stage/sha.out" ) &
    spid=$!
    {
        for c in "${chunks[@]}"; do
            # shellcheck disable=SC2086
            set -- $c; f="$4"
            until [[ -f "$f" ]]; do
                [[ -e "$stage/.fail" ]] && exit 1
                sleep 0.1
            done
            cat "$f"
        done
    } | tee "$stage/sha.fifo" | tar --use-compress-program="zstd -d -T0 --long=31" -xf - -C "$dst" || rc=$?
    kill "$rpid" 2>/dev/null || true; wait "$rpid" 2>/dev/null || true
    if (( rc != 0 )); then
        touch "$stage/.stop"; kill "$dpid" "$spid" 2>/dev/null || true; wait "$dpid" "$spid" 2>/dev/null || true
        rm -rf "$dst"; return 1
    fi
    wait "$dpid" "$spid" 2>/dev/null || true
    got="$(cat "$stage/sha.out" 2>/dev/null || true)"
    [[ "$got" == "$sha" ]] || { rm -rf "$dst" "$stage"; return 2; }
    return 0
}

# Move the content of directory $1 into $2 (merging directories that exist in both).
merge_into() {
    local e; mkdir -p "$2"
    for e in "$1"/* "$1"/.[!.]*; do
        [[ -e "$e" || -L "$e" ]] || continue
        if [[ -e "$2/${e##*/}" || -L "$2/${e##*/}" ]]; then cp -alf "$e" "$2/" 2>/dev/null || cp -af "$e" "$2/"; else mv "$e" "$2/"; fi
    done
    rm -rf "$1"
}

# Item timing for the summary: label, seconds, compressed bytes.
note_time() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$CAVLI_ROOT/cache/.timing"; }

# fetch_extract_gh NAME SHA gh:<tag>[:<n>] DEST STAGE — one public bundle file into DEST (verified, unpacked).
fetch_extract_gh() {
    local name="$1" sha="$2" spec="$3" dest="$4" stage="$5" tag n=1 i p base list="" size rc=0 t0=$SECONDS bytes=0
    tag="${spec#gh:}"; [[ "$tag" == *:* ]] && { n="${tag#*:}"; tag="${tag%%:*}"; }
    base="https://github.com/$BUNDLES_REPO/releases/download/$tag"
    mkdir -p "$stage"
    for ((i = 0; i < n; i++)); do
        p="$name"; (( n > 1 )) && p="$name.part$(printf '%02d' "$i")"
        ( url_size "$base/$p" > "$stage/size.$i" ) &
    done
    wait
    for ((i = 0; i < n; i++)); do
        p="$name"; (( n > 1 )) && p="$name.part$(printf '%02d' "$i")"
        size="$(cat "$stage/size.$i" 2>/dev/null || true)"
        [[ "$size" =~ ^[0-9]+$ ]] || die "$name: could not read the size of $p (network, or the asset is missing in $tag)"
        list+="$base/$p $size"$'\n'; bytes=$((bytes + size))
    done
    log "$name: fetching $((bytes >> 20)) MB in $n file(s), $DL_JOBS connections, unpacking while downloading"
    stream_extract "$name" "$sha" "$stage/x" "$stage" "" <<<"$list" || rc=$?
    case "$rc" in
        0) ;;
        2) die "$name: checksum mismatch — nothing installed" ;;
        *) die "download of $name failed — re-run to resume" ;;
    esac
    merge_into "$stage/x" "$dest"
    rm -rf "$stage"
    note_time "${name%%-1.*}" $((SECONDS - t0)) "$bytes"
    log "$name: done in $(fmt_secs $((SECONDS - t0))), $((bytes / (SECONDS - t0 + 1) >> 20)) MB/s average"
}

# Checksum of NAME in a --bundle-dir component dir: SHA256SUMS, else the release's NAME.sha256. Empty when neither.
local_sha() {
    local f s=""
    for f in "$1/SHA256SUMS" "$1/$2.sha256"; do
        [[ -f "$f" ]] || continue
        # a one-word NAME.sha256 is the bare sum
        s="$(awk -v n="$2" -v one="$([[ "$f" == *.sha256 ]] && echo 1)" '{f = $2; sub(/^\*/, "", f); sub(/.*\//, "", f)}
             f == n || (one && NF == 1) {print $1; exit}' "$f")"
        [[ -z "$s" ]] || break
    done
    printf '%s\n' "$s"
}

# Tool pins: GitHub release by default, the old Google Drive files with CAVLI_BUNDLE_SOURCE=drive.
pick_files() {
    local v="BUNDLE_FILES_$1"; [[ "${CAVLI_BUNDLE_SOURCE:-github}" == drive ]] && v="${v}_drive"
    printf '%s\n' "${!v}"
}
openwrt_files() {
    if [[ "${CAVLI_BUNDLE_SOURCE:-github}" == drive ]]; then printf '%s\n' "$BUNDLE_FILES_openwrt_drive"
    else printf '%s\n' "$BUNDLE_FILES_openwrt"; fi
}

prestage_component() {
    # $1 = component, $2 = "name sha256 id" list, $3 = dest (default $CAVLI_ROOT/$1/$BUNDLE_VERSION).
    # From --bundle-dir/<component> or Drive (resumed); sha256-checked, unpacked, marked .complete.
    local component="$1" files="$2" dest="${3:-$CAVLI_ROOT/$1/$BUNDLE_VERSION}" stage src_dir=""
    # .pins = the sha256 list staged; a changed pin restages. openwrt212 had no .pins and its pin changed.
    local pins have; pins="$(awk 'NF {print $2}' <<<"$files")"; have="$(cat "$dest/.pins" 2>/dev/null || true)"
    [[ -n "$have" || "$component" == openwrt212 ]] || have="$pins"
    [[ -f "$dest/.complete" && "$(cat "$dest/BUNDLE_VERSION" 2>/dev/null)" == "$BUNDLE_VERSION" && "$have" == "$pins" ]] \
        && { log "$component $BUNDLE_VERSION already staged at $dest"; return 0; }
    [[ -f "$dest/.complete" ]] && { log "$component: pinned content changed, restaging"; rm -f "$dest/.complete"; }
    if [[ -n "$BUNDLE_DIR" && -d "$BUNDLE_DIR/$component" ]]; then
        src_dir="$BUNDLE_DIR/$component"
        local local_bv; local_bv="$(cat "$src_dir/BUNDLE_VERSION" 2>/dev/null || true)"
        [[ "$local_bv" == "$BUNDLE_VERSION" ]] \
            || die "--bundle-dir: $src_dir/BUNDLE_VERSION is '$local_bv', expected $BUNDLE_VERSION"
    elif [[ "$files" == *"__PENDING__"* ]]; then
        die "$component bundle not published yet — pass --bundle-dir with $component/ in it"
    fi
    stage="$CAVLI_ROOT/cache/$component-$BUNDLE_VERSION"
    mkdir -p "$dest" "$stage"
    local fast_pids=() fp parts
    while read -r name sha id; do
        [[ -n "$name" ]] || continue
        local f="$stage/$name"
        # public GitHub assets: parallel ranges, unpacked while downloading, all files of the component at once
        if [[ -z "$src_dir" && "$id" == gh:* ]] && (( DL_JOBS > 0 )); then
            [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || die "$component/$name: no sha256 to check against"
            fetch_extract_gh "$name" "$sha" "$id" "$dest" "$stage/$name.d" & fast_pids+=($!)
            continue
        fi
        parts=()
        if [[ -n "$src_dir" ]]; then
            f="$src_dir/$name"
            # no pinned sum yet (unpublished): take it from the dir
            if [[ "$sha" == __* ]]; then
                sha="$(local_sha "$src_dir" "$name")"
                [[ -n "$sha" ]] || die "$component/$name: no sha256 to check against (put SHA256SUMS or $name.sha256 in $src_dir)"
            fi
            # a split release asset (name.partNNN) is read joined, in order
            if [[ ! -f "$f" ]]; then
                for fp in "$f".part[0-9][0-9][0-9]; do [[ -f "$fp" ]] && parts+=("$fp"); done
                (( ${#parts[@]} )) || die "--bundle-dir: $f (or $name.part000...) not found"
            fi
            log "$component: using $f${parts[0]:+ (${#parts[@]} parts)}"
        elif [[ ! -f "$f" ]]; then
            log "$component: fetching $name"
            if [[ "$id" == gh:* ]]; then release_fetch "$name" "$id" "$f"; else drive_fetch "$id" "$f"; fi
        fi
        [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || die "$component/$name: no sha256 to check against"
        if (( ${#parts[@]} )); then
            [[ "$(cat "${parts[@]}" | sha256sum | cut -d' ' -f1)" == "$sha" ]] || die "$component/$name checksum mismatch"
            case "$name" in
                *.tar.zst) cat "${parts[@]}" | tar --use-compress-program="zstd -d -T0 --long=31" -xf - -C "$dest";;
                *.tar)     cat "${parts[@]}" | tar -xf - -C "$dest";;
                *) die "don't know how to unpack $name";;
            esac
            continue
        fi
        echo "$sha  $f" | sha256sum -c --quiet - \
            || { [[ -n "$src_dir" ]] || rm -f "$f"; die "$component/$name checksum mismatch"; }
        case "$name" in
            *.tar.zst) tar --use-compress-program="zstd -d -T0 --long=31" -xf "$f" -C "$dest";;
            *.tar)     tar -xf "$f" -C "$dest";;
            *) die "don't know how to unpack $name";;
        esac
    done <<<"$files"
    for fp in "${fast_pids[@]+"${fast_pids[@]}"}"; do wait "$fp" || die "$component: download failed — re-run to resume"; done
    printf '%s\n' "$BUNDLE_VERSION" > "$dest/BUNDLE_VERSION"
    printf '%s\n' "$pins" > "$dest/.pins"
    touch "$dest/.complete"
    rm -rf "$stage"
    ok_size="$(du -sh "$dest" | cut -f1)"
    log "$component $BUNDLE_VERSION ready ($ok_size) at $dest"
}


# Qualcomm tool parts of a product (always the common one).
qcom_parts() {
    local p out=""
    for p in $1; do
        case "$p" in
            cqm220) out+=" qcom_common qcom_220";;
            cqm212) out+=" qcom_common qcom_212";;
            cqm211) out+=" qcom_common qcom_211";;
        esac    # aq62: apps only, no Qualcomm tools
    done
    tr ' ' '\n' <<<"$out" | awk 'NF && !s[$0]++'
}

# Runs inside a throwaway container: gh device login (if needed), then for each missing part download its release assets,
# verify, reassemble split files (name.partNNN) and unpack into $CAVLI_ROOT/<part>/<version>.
qcom_fetch_script() {
    declare -f fmt_secs log pool_init chunk_get stream_extract merge_into
    cat <<'SCRIPT'
set -euo pipefail
gh auth status --hostname github.com >/dev/null 2>&1 \
    || gh auth login --hostname github.com --git-protocol https --web \
    || { echo "qcom: GitHub login failed" >&2; exit 1; }
mkdir -p "$QCOM_STAGE" "$QCOM_ROOT/cache"
if (( DL_JOBS > 0 )); then
    # parallel ranges of the private assets through the API (token stays in this container, in a 0600 header file)
    HDR="$QCOM_STAGE/.hdr"; trap 'rm -f "$HDR"' EXIT
    ( umask 077; printf 'Authorization: Bearer %s\nAccept: application/octet-stream\n' "$(gh auth token)" > "$HDR" )
    pool_init
    ids="$(gh api "repos/$QCOM_REPO/releases/tags/$QCOM_TAG" --jq '.assets[] | "\(.name) \(.id) \(.size)"')" \
        || { echo "qcom: could not read $QCOM_REPO $QCOM_TAG — not an org member, or the release is missing" >&2; exit 1; }
    fetch_part() {
        local part="$1" name="cqm22x-$part-$QCOM_VERSION.tar.zst" stage="$QCOM_STAGE/$1" dest="$QCOM_ROOT/$1/$QCOM_VERSION" t0=$SECONDS sha list bytes rc=0 sid
        sid="$(awk -v n="$name.sha256" '$1 == n {print $2}' <<<"$ids")"
        list="$(awk -v n="$name" -v r="$QCOM_REPO" '$1 == n || index($1, n ".part") == 1 {print $1, $2, $3}' <<<"$ids" | sort | awk -v r="$QCOM_REPO" '{print "https://api.github.com/repos/" r "/releases/assets/" $2, $3}')"
        [[ -n "$sid" && -n "$list" ]] || { echo "qcom: $name not in $QCOM_REPO $QCOM_TAG — the asset is missing" >&2; return 1; }
        sha="$(curl -fsSL -H "@$HDR" "https://api.github.com/repos/$QCOM_REPO/releases/assets/$sid" | awk '{print $1; exit}')"
        [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || { echo "qcom: no sha256 for $name" >&2; return 1; }
        bytes="$(awk '{s += $2} END {print s}' <<<"$list")"
        log "$part: fetching $((bytes >> 20)) MB, $DL_JOBS connections, unpacking while downloading"
        stream_extract "$part" "$sha" "$stage/x" "$stage" "$HDR" <<<"$list" || rc=$?
        case "$rc" in
            0) ;;
            2) echo "qcom: checksum mismatch for $name — nothing installed" >&2; return 1;;
            *) echo "qcom: download of $name failed — re-run to resume" >&2; return 1;;
        esac
        mkdir -p "$dest"; merge_into "$stage/x" "$dest"
        printf '%s\n' "$QCOM_VERSION" > "$dest/BUNDLE_VERSION"
        touch "$dest/.complete"
        rm -rf "$stage"
        printf '%s\t%s\t%s\n' "cqm22x-$part" $((SECONDS - t0)) "$bytes" >> "$QCOM_ROOT/cache/.timing"
        log "$part: done in $(fmt_secs $((SECONDS - t0)))"
    }
    pids=(); for part in $QCOM_PARTS; do fetch_part "$part" & pids+=($!); done
    fail=0; for p in "${pids[@]}"; do wait "$p" || fail=1; done
    (( fail == 0 )) && rm -rf "$QCOM_STAGE"
    exit $fail
fi
for part in $QCOM_PARTS; do
    name="cqm22x-$part-$QCOM_VERSION.tar.zst"
    stage="$QCOM_STAGE/$part"; dest="$QCOM_ROOT/$part/$QCOM_VERSION"
    rm -rf "$stage"; mkdir -p "$stage" "$dest"
    gh release download "$QCOM_TAG" -R "$QCOM_REPO" -D "$stage" --clobber -p "$name*" \
        || { echo "qcom: could not download $name from $QCOM_REPO $QCOM_TAG — not an org member, or the asset is missing" >&2; exit 1; }
    cd "$stage"
    for p in "$name".part[0-9][0-9][0-9]; do
        [[ -e "$p" ]] || continue
        [[ -e "$name" ]] || cat "$name".part[0-9][0-9][0-9] > "$name"
        break
    done
    rm -f -- "$name".part[0-9][0-9][0-9]
    sha256sum -c "$name.sha256" || { echo "qcom: checksum mismatch for $name — nothing installed" >&2; exit 1; }
    tar --use-compress-program="zstd -d -T0 --long=31" -xf "$name" -C "$dest"
    printf '%s\n' "$QCOM_VERSION" > "$dest/BUNDLE_VERSION"
    touch "$dest/.complete"
    cd /; rm -rf "$stage"
done
SCRIPT
}

prestage_qcom_local() {
    # $1 = dest. --bundle-dir/qcom on disk (old layout: bare names, big files as name.partNNN): offline path.
    local dest="$1" src="$BUNDLE_DIR/qcom"
    [[ -d "$src" ]] || die "--bundle-dir: $src not found"
    local local_bv; local_bv="$(cat "$src/BUNDLE_VERSION" 2>/dev/null || true)"
    [[ "$local_bv" == "$BUNDLE_VERSION" ]] \
        || die "--bundle-dir: $src/BUNDLE_VERSION is '$local_bv', expected $BUNDLE_VERSION"
    [[ -f "$src/SHA256SUMS" ]] || die "--bundle-dir: $src/SHA256SUMS missing"
    ( cd "$src" && sha256sum -c SHA256SUMS >/dev/null ) \
        || die "qcom: checksum mismatch under $src"
    log "qcom: local bundle at $src"
    mkdir -p "$dest/qct/software"
    local f name base zst=(--use-compress-program="zstd -d -T0 --long=31")
    for f in "$src"/*.tar.zst "$src"/*.tar.zst.part000 "$src"/*.tar; do
        [[ -e "$f" ]] || continue
        name="$(basename "$f")"; base="${name%.part000}"
        case "$base" in
            sectools.tar.zst) cat "$src/$base"* | tar "${zst[@]}" -xf - -C "$dest";;
            *.tar.zst)        cat "$src/$base"* | tar "${zst[@]}" -xf - -C "$dest/qct/software";;
            *.tar)            tar -xf "$f" -C "$dest/qct/software";;
        esac
    done
}

# Legacy (single qcom bundle, whole release): runs inside a throwaway container: gh device login (if needed), download
# the qcom release, verify, reassemble split parts, unpack. $1 = dest.
qcom_fetch_script_legacy() {
    cat <<'SCRIPT'
set -euo pipefail
gh auth status --hostname github.com >/dev/null 2>&1 \
    || gh auth login --hostname github.com --git-protocol https --web \
    || { echo "qcom: GitHub login failed" >&2; exit 1; }
mkdir -p "$QCOM_STAGE"
gh release download "$QCOM_TAG" -R "$QCOM_REPO" -D "$QCOM_STAGE" --clobber \
    || { echo "qcom: could not download release $QCOM_TAG from $QCOM_REPO — not an org member, or the release is missing" >&2; exit 1; }
cd "$QCOM_STAGE"
sha256sum -c SHA256SUMS || { echo "qcom: checksum mismatch — nothing installed" >&2; exit 1; }
# reassemble any split parts (name.partNNN, numeric, zero-padded -> name)
for p in *.part[0-9][0-9][0-9]; do
    [[ -e "$p" ]] || continue
    base="${p%.part[0-9][0-9][0-9]}"
    [[ -e "$base" ]] && continue
    cat "${base}".part[0-9][0-9][0-9] > "$base"
done
rm -f -- *.part[0-9][0-9][0-9]
mkdir -p "$QCOM_DEST/qct/software"
for f in *.tar.zst *.tar; do
    [[ -e "$f" ]] || continue
    case "$f" in
        sectools.tar.zst|sectools.tar) tar --use-compress-program="zstd -d -T0 --long=31" -xf "$f" -C "$QCOM_DEST";;
        *.tar.zst) tar --use-compress-program="zstd -d -T0 --long=31" -xf "$f" -C "$QCOM_DEST/qct/software";;
        *.tar)     tar -xf "$f" -C "$QCOM_DEST/qct/software";;
    esac
done
cp -f BUNDLE_VERSION "$QCOM_DEST/BUNDLE_VERSION"
touch "$QCOM_DEST/.complete"
