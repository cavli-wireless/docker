set -euo pipefail

# Old names (cqm2xx-setup, aq62-setup) still work as a fallback; every use is reported.
OLD_NAMES_USED=""
env_compat() {  # env_compat NEW OLD...: NEW unset and an OLD one set -> NEW takes its value
    local new="$1" old; shift
    [[ -z "${!new:-}" ]] || return 0
    for old in "$@"; do
        [[ -n "${!old:-}" ]] || continue
        printf -v "$new" '%s' "${!old}"; export "${new?}"
        OLD_NAMES_USED+="$old->$new "; return 0
    done
}
